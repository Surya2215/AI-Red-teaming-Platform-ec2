# Copy to .env and fill in values for this deployment. Only variables actually
# read by core/config.py's Settings class are listed here.

ENVIRONMENT=local
LOG_LEVEL=INFO

# Optional: when set, every API request must send a matching X-API-Key header (see
# core/api.py's require_api_key middleware). Leave blank for local dev; set this on
# any deployment reachable beyond localhost (this EC2 box binds uvicorn to 0.0.0.0).
API_KEY=

# Database - Postgres.
DATABASE_URL=postgresql+asyncpg://redteam:redteam@localhost:5432/redteam

# Per-tool Python interpreters (isolated venvs so tool deps don't conflict with the
# API's own deps) - see scripts/setup_tool_venvs.sh. Linux paths on this EC2 box,
# e.g. ./tool-venvs/garak-venv/bin/python.
GARAK_PYTHON=./tool-venvs/garak-venv/bin/python
PYRIT_PYTHON=./tool-venvs/pyrit-venv/bin/python
DEEPTEAM_PYTHON=./tool-venvs/deepteam-venv/bin/python
PYRIT_MEMORY_DB_PATH=~/.local/share/dbdata/pyrit.db

# Tool Scan async pipeline (Celery worker on this EC2 box).
# RabbitMQ is the task queue: only a job_id is ever placed on it, never credentials.
# Valkey is the Celery result backend. Generate ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RABBITMQ_URL/VALKEY_URL are what the app connects with - keep the credentials
# embedded in them in sync with RABBITMQ_DEFAULT_USER/PASS and VALKEY_PASSWORD
# below, which are what docker-compose.yml uses to provision the containers.
# No default credentials are shipped - docker-compose refuses to start without
# these set (this box is reachable beyond localhost, unlike a laptop dev setup).
RABBITMQ_URL=amqp://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5672//
VALKEY_URL=redis://:CHANGE_ME_PASSWORD@localhost:6379/0
RABBITMQ_DEFAULT_USER=CHANGE_ME_USER
RABBITMQ_DEFAULT_PASS=CHANGE_ME_PASSWORD
VALKEY_PASSWORD=CHANGE_ME_PASSWORD
ENCRYPTION_KEY=

# Production user auth/RBAC/audit trail (core/auth.py) - opt-in, see
# core/config.py's auth_enabled Field comment. AUTH_ENABLED=false (the default)
# preserves today's no-login behavior; set it to true for any deployment with
# more than one human operator.
AUTH_ENABLED=false
# Required once AUTH_ENABLED=true. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=480
# Bootstrap admin, created once on startup if the users table is empty - the only
# way to get a first login on a fresh deployment (there is no public signup).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional LLM provider settings used by the platform.
LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Optional alternatives.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
